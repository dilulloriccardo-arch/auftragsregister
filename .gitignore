# The raw pulls stay local: they are 150 MB of JSON that the site already renders,
# and re-fetching them costs nothing but time. The repo carries the site.
dati/
*.log
__pycache__/
*.bak
*.bak[0-9]*
*.bak-*
*.orig
indexnow.key

# Subscriber e-mail addresses: never in the public repo (nDSG / GDPR).
avvisi/stato.json*
avvisi/*.lock
